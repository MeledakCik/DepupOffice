<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog muncul: membesar dari 88% dengan pantulan lembut sambil menebal cepat. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <scale android:fromXScale="0.88" android:toXScale="1" android:fromYScale="0.88" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="380"
        android:interpolator="@interpolator/overshoot_soft" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="160"
        android:interpolator="@interpolator/standard" />
</set>
