<?xml version="1.0" encoding="utf-8"?>
<!-- Layar lama mundur: bergeser sedikit ke kiri, menyusut ke 96% & meredup — seirama layar baru. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <translate android:fromXDelta="0" android:toXDelta="-8%" android:duration="460"
        android:interpolator="@interpolator/emphasized_decelerate" />
    <scale android:fromXScale="1" android:toXScale="0.96" android:fromYScale="1" android:toYScale="0.96"
        android:pivotX="50%" android:pivotY="50%" android:duration="460"
        android:interpolator="@interpolator/emphasized_decelerate" />
    <alpha android:fromAlpha="1" android:toAlpha="0.8" android:duration="460"
        android:interpolator="@interpolator/standard" />
</set>
