<?xml version="1.0" encoding="utf-8"?>
<!-- Kembali: layar sebelumnya maju lagi ke tempatnya dengan pantulan pegas kecil & kembali terang. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <translate android:fromXDelta="-8%" android:toXDelta="0" android:duration="420"
        android:interpolator="@interpolator/glide_spring" />
    <scale android:fromXScale="0.96" android:toXScale="1" android:fromYScale="0.96" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="420"
        android:interpolator="@interpolator/glide_spring" />
    <alpha android:fromAlpha="0.8" android:toAlpha="1" android:duration="420"
        android:interpolator="@interpolator/standard" />
</set>
