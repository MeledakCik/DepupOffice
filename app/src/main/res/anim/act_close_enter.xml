<?xml version="1.0" encoding="utf-8"?>
<!-- Kembali: layar sebelumnya maju lagi ke tempatnya & terang kembali — cermin dari saat dibuka. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <translate android:fromXDelta="-3%" android:toXDelta="0" android:duration="300"
        android:interpolator="@interpolator/emphasized_decelerate" />
    <alpha android:fromAlpha="0.9" android:toAlpha="1" android:duration="300"
        android:interpolator="@interpolator/emphasized_decelerate" />
</set>
