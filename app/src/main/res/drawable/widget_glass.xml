<?xml version="1.0" encoding="utf-8"?>
<!-- Kaca widget: kilau di sepertiga atas + tepi terang tipis, di atas latar tembus (widget_bg, alpha 0,84).
     Widget Android tidak boleh mengaburkan wallpaper, jadi "kaca"-nya tanpa blur. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="270" android:centerColor="#00FFFFFF" android:centerY="0.42"
                android:endColor="#00FFFFFF" android:startColor="@color/widget_sheen" android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/widget_rim" />
        </shape>
    </item>
</layer-list>
