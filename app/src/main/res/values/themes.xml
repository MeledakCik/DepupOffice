<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight: dialog sistem (AlertDialog, menu pop-up, pemilih) ikut tema terang/gelap. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="alertDialogTheme">@style/DlgTheme</item>
        <item name="android:popupMenuStyle">@style/PopupMenu</item>
        <item name="android:fontFamily">@font/funnel_display_regular</item>
        <item name="fontFamily">@font/funnel_display_regular</item>
        <item name="android:windowAnimationStyle">@style/ScreenMotion</item>
    </style>

    <!-- Perpindahan layar seragam di seluruh aplikasi (otomatis mati bila animasi HP dimatikan). -->
    <style name="ScreenMotion" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/act_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/act_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/act_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/act_close_exit</item>
    </style>

    <style name="PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/dlg_bg</item>
    </style>

    <style name="DlgTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dlg_bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="colorAccent">@color/accent</item>
        <item name="buttonBarPositiveButtonStyle">@style/DlgButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DlgButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/DlgButton</item>
        <item name="android:fontFamily">@font/funnel_display_regular</item>
        <item name="fontFamily">@font/funnel_display_regular</item>
    </style>

    <!-- Tombol dialog: huruf biasa (bukan KAPITAL semua) agar lebih mudah dibaca, tinggi 48dp. -->
    <style name="DlgButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">@font/funnel_display_medium</item>
        <item name="fontFamily">@font/funnel_display_medium</item>
    </style>

    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
